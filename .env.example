# Heyloo — environment variables
#
# Copy this file to `.env` (root) and/or the env config of the relevant
# Supabase edge function / app, then fill in real values. NEVER commit a
# `.env` file with real values — .gitignore already excludes .env*.
#
# Every value below is a placeholder. Before wiring the real integration,
# verify field names/auth/limits against the CURRENT vendor docs
# (CLAUDE.md Rule 1) — do not trust this file's shape alone.

# ── Supabase ──────────────────────────────────────────────────────────────
# New publishable/secret key system (never legacy anon/service_role names —
# CLAUDE.md Rule 1.3). supabase.com/docs/guides/api/api-keys
SUPABASE_URL=                        # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=            # sb_publishable_... — safe for the client/dashboard
SUPABASE_SECRET_KEY=                 # sb_secret_... — server only, never shipped to a browser
SB_PUBLISHABLE_KEY=                  # OPTIONAL override for edge functions (job-realtime-keepalive joins Realtime with it). Not needed: functions read the platform-provided SUPABASE_PUBLISHABLE_KEYS dictionary ("default" key).
SB_SECRET_KEY=                       # OPTIONAL override for edge functions. Not needed: functions read the platform-provided SUPABASE_SECRET_KEYS dictionary ("default" key) automatically. Set only to pin a specific key.
# apps/web (T5) needs the URL + publishable key inlined into the browser
# bundle, which Next.js only does for NEXT_PUBLIC_-prefixed vars — same
# values as SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY above, duplicated under
# this prefix rather than read dynamically (Next's build-time inlining
# needs the literal `process.env.NEXT_PUBLIC_X` form, see src/lib/env.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=                 # <project-ref>, used by the Supabase CLI
SUPABASE_PROJECT_REF=                # same <project-ref> value as SUPABASE_PROJECT_ID above, under the name scripts/sync-agent-templates.ts reads (CALL-3, docs/DEPLOY.md §3.4) — kept as a separate var rather than reusing SUPABASE_PROJECT_ID so the script's own required-env-var list is self-documenting
SUPABASE_ACCESS_TOKEN=               # personal/CI access token for `supabase` CLI (link, db push, functions deploy); also read by scripts/sync-agent-templates.ts and scripts/apply-auth-templates.ts (Management API, not the `supabase` CLI)
SUPABASE_DB_URL=                     # postgres connection string, for `supabase db lint`/`diff` in CI against a linked/preview branch
SUPABASE_POOLER_URL=                 # optional (QA-1 BE-14): Supavisor TRANSACTION-mode pooler string (port 6543) for the edge functions' NON-hot-path DB clients (prepare:false, 1 connection per isolate); unset = direct SUPABASE_DB_URL as before. The /voice/tools hot path always stays direct. Set as an edge-function secret, not a web env var

# ── Retell (voice provider) ───────────────────────────────────────────────
RETELL_API_KEY=                      # server-side only — packages/adapters/retell; also the DEFAULT key /voice/events,
                                      # /voice/tools HMAC verification signs against (Retell signs webhooks with the
                                      # account's API key — no separate signing secret exists, OPS-4)
RETELL_WEBHOOK_SIGNING_SECRET=       # OPTIONAL override for the above (e.g. mid-rotation) — leave unset; falls back to RETELL_API_KEY
RETELL_SIP_TRUNK_TERMINATION_URI=    # e.g. <trunk>.pstn.twilio.com — REQUIRED on every /import-phone-number call
                                      # (RETELL-VERIFY: confirmed via retell-typescript-sdk); one platform-level
                                      # Twilio Elastic SIP Trunk, provisioned once (Week-0), not per-tenant
RETELL_INBOUND_WEBHOOK_URL=          # https://<project-ref>.supabase.co/functions/v1/voice-inbound — wired onto
                                      # each imported PHONE NUMBER (RETELL-VERIFY: confirmed phone-number-scoped,
                                      # not agent-scoped, contra an earlier assumption)
FORWARDING_TEST_FROM_NUMBER=         # OPTIONAL. E.164 platform-owned Retell number the phone-setup forwarding test calls the
                                      # owner's business phone FROM (forwarding-verify). Unset -> +16105383920, the line
                                      # api-admin-self-call already dials from. Must be a number in this Retell account.

# ── Twilio (telephony — we own every number) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=                  # prefer a scoped API key/secret over the account auth token where possible
TWILIO_API_KEY_SECRET=
TWILIO_WEBHOOK_SIGNING_SECRET=       # X-Twilio-Signature validation on inbound webhooks / status callbacks
                                      # NOTE (T3, Rule 1): Twilio's actual X-Twilio-Signature scheme signs
                                      # with the account's primary Auth Token itself (TWILIO_AUTH_TOKEN above),
                                      # not a separate secret — supabase/functions/_shared/providers/messaging/twilio-signature.ts
                                      # verifies against TWILIO_AUTH_TOKEN. Leaving this var defined in case a
                                      # distinct Messaging-Service-level signing key is confirmed to exist.
# A2P 10DLC reseller-brand registration (SYSTEM_DESIGN §7, G4) — filled in once the brand/campaign are approved:
TWILIO_A2P_BRAND_SID=                # platform-level BrandRegistration SID (Week-0, one-time — see api-a2p-register/handler.ts).
                                      # MESSAGING-1: carriers require a brand PER END BUSINESS for ISVs, so this shared-brand
                                      # flow is kept for parity only (docs/design/MESSAGING_PROVIDERS.md). Unset = api-a2p-register answers 503.
TWILIO_A2P_CAMPAIGN_SID=
A2P_PRIVACY_POLICY_URL=              # T4 api-a2p-register — must resolve to a real, live policy page (Twilio requirement as of the 2026-06-30 campaign-registration change)
A2P_TERMS_URL=
A2P_INTERNAL_SECRET=                 # lets api-provision (or another internal caller) trigger api-a2p-register without a tenant-owner JWT

# ── Stripe (billing: Checkout + Billing Meters) ───────────────────────────
STRIPE_SECRET_KEY=                    # Stripe API key; api-checkout, job-billing-cycle, and webhooks-stripe (reads each charge's real processing fee from its balance transaction; without it charge.succeeded is deferred, never recorded with a made-up fee)
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=       # verifies /webhooks/stripe raw-body signature
STRIPE_METER_EVENT_NAME=             # the Billing Meter event name for metered minutes usage (scripts/setup-stripe.ts creates the Meter under this name)
CHECKOUT_SUCCESS_URL=                # T4 api-checkout — Stripe Checkout Session success_url (provisioning-progress screen)
CHECKOUT_CANCEL_URL=                 # T4 api-checkout — Stripe Checkout Session cancel_url
BILLING_PORTAL_RETURN_URL=           # api-billing-portal — where the Stripe Billing Portal's "return" link goes (the tenant dashboard billing page, https://<app>/en/dashboard/billing); needs a portal configuration saved once in the Stripe Dashboard

# ── PayPal (referral payouts) ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                   # sandbox | live
PAYPAL_WEBHOOK_ID=                   # for verifying PayPal webhook signatures on payout status events

# ── ElevenLabs (TTS voice IDs — portable across voice providers) ─────────
ELEVENLABS_API_KEY=                  # only needed if we manage/preview voices directly, outside Retell's own ElevenLabs passthrough

# ── Outreach: lead fetch ───────────────────────────────────────────────────
APOLLO_API_KEY=
OUTSCRAPER_API_KEY=

# ── Outreach: campaign send + reply webhooks ──────────────────────────────
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SIGNING_SECRET=
INSTANTLY_API_KEY=                   # alternate/second outreach send provider (SYSTEM_DESIGN §3 lists Smartlead/Instantly)
INSTANTLY_WEBHOOK_SIGNING_SECRET=

# ── Partner portal ─────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Tenant dashboard: Airtable delivery adapter OAuth (apps/web/src/app/api/tenant/delivery/airtable) ──
AIRTABLE_OAUTH_CLIENT_ID=            # Heyloo's registered Airtable OAuth app (dashboard/delivery Airtable connect)
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=         # https://<app-domain>/api/tenant/delivery/airtable/callback
AIRTABLE_OAUTH_STATE_SECRET=         # HMAC-SHA256 key signing the short-lived OAuth state+PKCE-verifier cookie (same pattern as SIGNUP_DRAFT_SECRET) — required for apps/web and api-adapter-connect

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=              # apps/web browser bundle (instrumentation-client.ts) — same DSN as SENTRY_DSN, NEXT_PUBLIC_-prefixed for client inlining
SENTRY_AUTH_TOKEN=                   # for sourcemap upload / release creation in CI
SENTRY_ORG=
SENTRY_PROJECT=
# T9 — supabase/functions/_shared/logger.ts reads these two directly (no
# apps/web equivalent needed; @sentry/nextjs sets them itself there).
# Optional: unset SENTRY_DSN entirely to disable edge-function Sentry
# reporting outright (every existing test runs this way) — see
# docs/OPS_RUNBOOK.md §2.
SENTRY_ENVIRONMENT=production        # tags every edge-function Sentry event; defaults to "production" if unset
SENTRY_RELEASE=                      # optional release/version tag on edge-function Sentry events, e.g. a git SHA

# ── Analytics (apps/web — FRONTEND_SPEC §0.8 DECIDE: PostHog) ────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=            # e.g. https://us.i.posthog.com

# ── Signup pre-auth draft cookie (apps/web, FRONTEND_SPEC §4 DECIDE) ──────
SIGNUP_DRAFT_SECRET=                 # random 32+ byte secret signing the short-lived signup-progress cookie (HMAC-SHA256)

# ── LLM (task LLM-1, docs/design/LLM_PROVIDERS.md) ────────────────────────
# Every LLM feature goes through one provider-neutral port: the text agent (SMS +
# web chat), menu import, the demo website scrape, outreach personalization,
# review scoring and reply classification. Gemini is the owner's chosen provider.
# No LLM key is read at module load: with none set, each feature answers a clear
# "AI not configured" state (menu import page, HTTP 503 ai_not_configured) or
# skips its cron run — nothing crashes.
LLM_PROVIDER=                        # gemini | anthropic. Unset = gemini (needs GEMINI_API_KEY). Anthropic is used ONLY when set to "anthropic" — no silent fallback either way
GEMINI_API_KEY=                      # Google AI Studio / Gemini API key (sent as the x-goog-api-key header, never in a URL). Supabase secret; required when LLM_PROVIDER is gemini/unset
GEMINI_MODEL=gemini-3.5-flash-lite   # fast tier: extraction, classification, summaries. Stable id per ai.google.dev/gemini-api/docs/models ("cost-efficient ... simple data processing"; $0.30 in / $2.50 out per 1M tokens). Unset = this default
GEMINI_MODEL_QUALITY=                # quality tier: text-agent tool-calling replies + outreach opening lines. Unset = GEMINI_MODEL. Bump to e.g. gemini-3.8-flash for better booking judgment (pricier)
GEMINI_MODEL_VISION=                 # tier that reads menu photos/PDFs (api-menu-import). Unset = GEMINI_MODEL
GEMINI_THINKING_HEADROOM_TOKENS=1024 # extra output-token allowance for the model's reasoning tokens (they count against maxOutputTokens). Unset = 1024
GEMINI_SAFETY_THRESHOLD=             # optional: BLOCK_LOW_AND_ABOVE | BLOCK_MEDIUM_AND_ABOVE | BLOCK_ONLY_HIGH | BLOCK_NONE | OFF applied to the four adjustable harm categories. Unset = the model default (Off for Gemini 2.0+)
ANTHROPIC_API_KEY=                   # ONLY when LLM_PROVIDER=anthropic (the second adapter). Also lets a batch submitted before a provider switch still be collected
ANTHROPIC_MODEL=claude-haiku-4-5     # anthropic adapter, fast tier. Unset = this default
ANTHROPIC_MODEL_QUALITY=claude-sonnet-5  # anthropic adapter, quality tier. Unset = claude-sonnet-5 (or ANTHROPIC_MODEL if that is set)
ANTHROPIC_MODEL_VISION=claude-sonnet-5   # anthropic adapter, vision tier. Unset = claude-sonnet-5 (or ANTHROPIC_MODEL if that is set)

# ── App-level ──────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
APP_BASE_URL=http://localhost:3000   # public origin: absolute links in outbound SMS/email AND the marketing site's sitemap, robots, RSS and og:image URLs (set to the production origin on Vercel)

# ── Messaging providers (MESSAGING-1, docs/design/MESSAGING_PROVIDERS.md) ──
# Every SMS/email send goes through one provider-neutral registry. Per message the
# provider is: the sending number's own (messaging_senders.provider) > the tenant's
# (tenants.sms_provider) > SMS_PROVIDER below. A chosen provider with missing secrets
# fails closed (message parked, dead-lettered after 24h as provider_not_configured).
SMS_PROVIDER=telnyx                  # platform default SMS adapter: telnyx | twilio
EMAIL_PROVIDER=resend                # platform default email adapter: resend | smtp | microsoft_graph (smtp = your own domain mailbox over implicit TLS, see "Email over SMTP" below and docs/SETUP_EMAIL.md; microsoft_graph = your Microsoft 365 mailbox over HTTPS, see "Email over Microsoft Graph" below and docs/SETUP_EMAIL_MICROSOFT.md)
TELNYX_API_KEY=                      # Telnyx API v2 key (Bearer) — required to send SMS via Telnyx
TELNYX_PUBLIC_KEY=                   # base64 Ed25519 public key (Mission Control -> Keys & Credentials) — verifies telnyx-signature-ed25519 on /webhooks-sms/telnyx; unset = those webhooks are rejected (503)
TELNYX_MESSAGING_PROFILE_ID=         # optional — sent with every message; unset = each number's own messaging profile applies
WEBHOOKS_SMS_BASE_URL=               # https://<project-ref>.supabase.co/functions/v1/webhooks-sms — public URL of the provider-neutral SMS webhook; the worker asks providers to POST delivery receipts to <this>/<provider>/status; required by webhooks-sms (Twilio signs the full URL)

# ── Email over SMTP (MSG-3 — the owner's own domain mailbox; docs/SETUP_EMAIL.md) ──
# EMAIL_PROVIDER=smtp turns this on. Implicit TLS ONLY: Supabase Edge Functions block
# outgoing ports 25 and 587 (supabase.com/docs/guides/functions/limits), so the adapter
# speaks TLS-from-the-first-byte on 465 and rejects 25/587 at config time (the provider
# then reports "not configured" instead of hanging). Any missing/invalid value = same.
SMTP_HOST=                           # e.g. smtp.gmail.com (Google Workspace) | smtp.zoho.com / smtppro.zoho.com (Zoho) — a bare host name, no scheme or port
SMTP_PORT=465                        # optional, default 465 (implicit TLS). 25 and 587 are rejected. Microsoft 365 only offers 587 for SMTP AUTH, so it cannot be used from Edge Functions: use EMAIL_PROVIDER=microsoft_graph (next section)
SMTP_USERNAME=                       # the FULL mailbox address, e.g. alerts@yourdomain.com
SMTP_PASSWORD=                       # the mailbox's app password (Google: 16 characters, paste WITHOUT the spaces) — never the account's sign-in password when 2-step verification is on
# EMAIL_FROM_ADDRESS (below) must be that same mailbox (or an alias it may send as).

# ── Email over Microsoft Graph (EMAIL-MSGRAPH — one Microsoft 365 mailbox over HTTPS; docs/SETUP_EMAIL_MICROSOFT.md) ──
# EMAIL_PROVIDER=microsoft_graph turns this on. HTTPS only (Edge Functions cannot open SMTP on
# 25/587). The Entra app must be limited to the ONE sending mailbox with Exchange RBAC for
# Applications (an unscoped Mail.Send grant can send as ANY mailbox in the tenant). Any missing
# or invalid value = "not configured": nothing is sent and nothing is reported as sent.
MS_TENANT_ID=                        # Entra "Directory (tenant) ID" GUID (or a verified domain name) of the Microsoft 365 tenant
MS_CLIENT_ID=                        # Entra app registration "Application (client) ID" GUID
MS_CLIENT_SECRET=                    # Entra client secret VALUE (not the secret ID). Expires (max 24 months, recommended < 12): rotate before then or ALL email stops. Set it in the Supabase secrets page, never in chat
# EMAIL_FROM_ADDRESS (below) must be the sending mailbox's own address, e.g. "Heyloo <ms@heycuey.com>".

# ── Supabase Auth Send Email Hook (EMAIL-MSGRAPH — supabase/functions/auth-send-email) ──
SEND_EMAIL_HOOK_SECRET=              # Standard Webhooks signing secret, format v1,whsec_<base64>. NOT chosen by hand: scripts/enable-auth-email-hook.ts --apply generates it and sets it here (function secret) and on the Auth config. Unset = the hook rejects every call (fail closed). Several values may be joined with | for rotation

# ── Email (shared by every email provider; Resend needs only its API key) ──
RESEND_API_KEY=                      # EMAIL_PROVIDER=resend only: alone (with EMAIL_FROM_ADDRESS) is enough to turn on owner alerts by email — no Twilio needed
EMAIL_FROM_ADDRESS=                  # e.g. "Heyloo <alerts@yourdomain.com>" — Resend: a Resend-verified sending domain; SMTP: the SMTP_USERNAME mailbox (or an alias it may send as), ASCII address; Microsoft Graph: the sending mailbox's own address (the mailbox the Entra app is restricted to), e.g. "Heyloo <ms@heycuey.com>"
RESEND_FROM_ADDRESS=                 # legacy name for EMAIL_FROM_ADDRESS, still honored when EMAIL_FROM_ADDRESS is unset

# ── Geocoding (MASTER_SPEC §3.0 create_order delivery-radius check) ──────
GEOCODE_API_KEY=                     # Geocodio api_key — see docs/VERIFY.md VERIFY-12. Unset = create_order's saved-address geocode step no-ops (order still completes)

# ── Edge functions: internal auth / cron (supabase/functions, T3) ─────────
CRON_INVOKE_SECRET=                  # shared secret pg_cron's pg_net calls present to worker-*/job-* functions
PROVISION_INTERNAL_SECRET=           # lets webhooks-stripe trigger api-provision without a tenant-owner JWT
ADMIN_AAL2_FRESHNESS_MINUTES=15      # BACKEND_SPEC §11.3 — session-level only, see admin-auth.ts's own caveat
VOICE_TOOLS_WEBHOOK_URL=             # T4 admin/index.ts — https://<project-ref>.supabase.co/functions/v1/voice-tools, passed to the template compiler as each tool's webhook `url`; also read by api-provision/index.ts for the same purpose (provisioning saga's real compiler wiring, EDGE_AUDIT B2 fix)
VOICE_EVENTS_WEBHOOK_URL=            # https://<project-ref>.supabase.co/functions/v1/voice-inbound — webhook URL passed to Retell when creating/updating agents during provisioning (api-provision, api-admin-provision-test-tenant read this)

# ── Edge functions: per-function webhook URLs (must match the exact URL the
# ── provider signs against — trailing slash/query mismatches break
# ── signature verification silently) ──────────────────────────────────────
WEBHOOKS_TWILIO_SMS_URL=             # https://<project-ref>.supabase.co/functions/v1/webhooks-twilio-sms (legacy Twilio inbound URL; new numbers use WEBHOOKS_SMS_BASE_URL + /twilio)
WEBHOOKS_POS_SQUARE_URL=             # https://<project-ref>.supabase.co/functions/v1/webhooks-pos/square

# ── Edge functions: outreach webhook auth (BACKEND_SPEC §7.5 — Smartlead is
# ── the chosen sender, MASTER_SPEC §2 binding; T8) ────────────────────────
OUTREACH_WEBHOOK_SECRET=             # shared-secret header until a real Smartlead HMAC scheme is confirmed (docs/VERIFY.md)

# ── Edge functions: outreach lead fetch/personalize/send (T8) ────────────
# The LLM steps (research batch = fast tier, opening-line hook = quality tier, reply
# classification = fast tier) use the LLM_PROVIDER / *_MODEL settings above (LLM-1).
OUTREACH_CAN_SPAM_FOOTER=            # required physical-address + unsubscribe-instructions text merged into every campaign send (compliance hard rule) — campaign create/personalize refuse (501) without this set

# ── Edge functions: outreach phone-complaint review scoring (OUTREACH-2) ──
# job-outreach-review-score classifies with the fast tier (GEMINI_MODEL) — no dedicated model var since LLM-1.

# ── Edge functions: Square POS adapter (webhooks-pos, first handleWebhook) ──
SQUARE_WEBHOOK_SIGNATURE_KEY=        # HMAC-SHA256(notificationUrl + rawBody) — re-verify against Square's current docs

# ── Edge functions: text-agent engine (webhooks-twilio-sms, api-text-chat;
# ── Cluster T) ─────────────────────────────────────────────────────────
# The tool-calling loop for SMS/web-chat replies uses the quality tier
# (GEMINI_MODEL_QUALITY) of the LLM settings declared above (LLM-1).
# Reuses the LLM settings, APP_BASE_URL, STRIPE_SECRET_KEY,
# PAYMENT_LINK_SUCCESS_URL/PAYMENT_LINK_CANCEL_URL already declared above —
# no usable LLM key simply disables the AI reply (STOP/HELP/waitlist-
# YES keep working; an ordinary message is archived only, never replied to;
# api-text-chat answers 503 ai_not_configured).
# api-text-chat (the web widget's chat mode) also requires
# WIDGET_TOKEN_SECRET (already declared below, Cluster W) — it verifies the
# same widget_token apps/web mints, never a second secret of its own; see
# docs/audit/CHANNELS_REQUESTS.md item 4 for the full contract.

# ── Edge functions: demo agent (api-demo-agent, BACKEND_SPEC §7.8) ────────
# The hours/services extraction pass uses the fast tier (GEMINI_MODEL: cheap/fast, <60s demo budget);
# menu extraction (api-menu-import) uses the vision tier for photos/PDFs (GEMINI_MODEL_VISION).
# api-demo-agent needs only RETELL_API_KEY (+ the database) to boot. The business-type demo on the home page and /demo
# (DEMO-2) reads each demo tenant's Retell agent id from agent_configs at request time, so it needs none of the three below.
# The LLM key (GEMINI_API_KEY, declared above) is used ONLY by the "build a demo from my website" flow: unset -> that flow answers 503 ai_not_configured.
DEMO_AGENT_ID=                       # optional. Retell agent the website-scrape flow's confirm step mints against, and the fallback for the "Auto repair" demo until the demo-auto-repair tenant has its own agent; unset -> that flow answers 503 not_configured
DEMO_PHONE_E164=                     # optional. Shared demo phone number shown alongside the web-call option; apps/web also reads it (build time) to show the phone fallback in the "Talk to Heyloo" demo

# ── Edge functions: phone payments (voice-tools send_payment_link, MASTER_SPEC §3.2) ─
PAYMENT_LINK_SUCCESS_URL=            # Stripe Checkout success redirect
PAYMENT_LINK_CANCEL_URL=             # Stripe Checkout cancel redirect

# ── Edge functions: Retell failover (job-retell-health-failover, G5) ──────
RETELL_FAILOVER_VOICE_URL=           # TwiML voice URL Twilio numbers are flipped to during a Retell outage (forward-to-owner-cell + voicemail)

# ── Edge functions: text agent + embeddable widget (Channels, BACKEND_SPEC §13) ──
# The widget's web-chat mode runs the same text-agent engine, so it uses the
# same LLM settings (declared once, above); see docs/BUILD_NOTES.md.
WIDGET_TOKEN_SECRET=                 # HMAC-SHA256 key signing the embeddable widget's short-lived session token (same pattern as SIGNUP_DRAFT_SECRET/AIRTABLE_OAUTH_STATE_SECRET) — minted only after checking the request Origin against tenants.widget_settings.allowed_origins and the presented widget_public_key against tenants.widget_public_key

# ── Edge functions: deep-integration adapters (worker-adapter-push,
# ── webhooks-pos, api-adapter-connect — BACKEND_SPEC §7.6, T7) ────────────
SHOPMONKEY_WEBHOOK_SIGNING_SECRET=   # HMAC-SHA256(rawBody) hex — documented hypothesis, re-verify against shopmonkey.dev (docs/VERIFY.md)
SQUARE_CLIENT_ID=                    # Heyloo's registered Square OAuth application id (api-adapter-connect + worker-adapter-push token refresh)
SQUARE_CLIENT_SECRET=
SQUARE_OAUTH_REDIRECT_URI=           # https://<project-ref>.supabase.co/functions/v1/api-adapter-connect callback landing page (apps/web) that forwards code+state here
GOOGLE_CALENDAR_CLIENT_ID=           # Google Cloud OAuth client (Calendar scope) — G10 generic calendar adapter
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=
EZYVET_CLIENT_ID=                    # Heyloo's approved ezyVet partner client_id (API_AND_FLOWS.md A.6 — partner-gated, one set shared across every connected practice)
EZYVET_CLIENT_SECRET=
EZYVET_PARTNER_ID=                   # approved partner_id minted alongside the client credentials above
ADAPTER_CONNECT_STATE_SECRET=        # HMAC key signing api-adapter-connect's OAuth `state` param (tenant-bound, 15-min replay window)
ADAPTER_TOKEN_ENCRYPTION_KEY=        # base64-encoded 32-byte AES-256-GCM key (edge functions also accept 64 hex chars since QA-1; apps/web still needs the base64 form, so generate base64) (`openssl rand -base64 32`) encrypting adapter_connections.access_token/refresh_token at rest (DB_AUDIT DB-H2); read by api-adapter-connect (encrypt on write) and worker-adapter-push (decrypt on read, re-encrypt on refresh) — _shared/crypto.ts tolerates legacy plaintext rows written before this key existed, so rotating/introducing it needs no backfill migration; also read by apps/web's api/tenant/delivery/airtable/callback route (encrypt on write, via its own apps/web/src/lib/crypto/adapter-token.ts duplicate — cross-project build-boundary, same format/key)
INTAKE_ENCRYPTION_KEY=               # base64-encoded 32-byte AES-256-GCM key (`openssl rand -base64 32`) encrypting intake_submissions.dob_encrypted/insurance_*_encrypted at rest (GAP_REGISTER Cluster G item 4) — a DEDICATED key, deliberately not shared with ADAPTER_TOKEN_ENCRYPTION_KEY so the two can be rotated independently; read by api-intake only
