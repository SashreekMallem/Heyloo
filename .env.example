# Heyloo — environment variables
#
# Copy this file to `.env` (root) and/or the env config of the relevant
# Supabase edge function / app, then fill in real values. NEVER commit a
# `.env` file with real values — .gitignore already excludes .env*.
#
# Every value below is a placeholder. Before wiring the real integration,
# verify field names/auth/limits against the CURRENT vendor docs
# (CLAUDE.md Rule 1) — do not trust this file's shape alone.

# ── Supabase ──────────────────────────────────────────────────────────────
# New publishable/secret key system (never legacy anon/service_role names —
# CLAUDE.md Rule 1.3). supabase.com/docs/guides/api/api-keys
SUPABASE_URL=                        # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=            # sb_publishable_... — safe for the client/dashboard
SUPABASE_SECRET_KEY=                 # sb_secret_... — server/edge-function only, never shipped to a browser
SUPABASE_PROJECT_ID=                 # <project-ref>, used by the Supabase CLI
SUPABASE_ACCESS_TOKEN=               # personal/CI access token for `supabase` CLI (link, db push, functions deploy)
SUPABASE_DB_URL=                     # postgres connection string, for `supabase db lint`/`diff` in CI against a linked/preview branch

# ── Retell (voice provider) ───────────────────────────────────────────────
RETELL_API_KEY=                      # server-side only — packages/adapters/retell
RETELL_WEBHOOK_SIGNING_SECRET=       # verifies /voice/events, /voice/tools raw-body HMAC (fail closed if unset)

# ── Twilio (telephony — we own every number) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=                  # prefer a scoped API key/secret over the account auth token where possible
TWILIO_API_KEY_SECRET=
TWILIO_WEBHOOK_SIGNING_SECRET=       # X-Twilio-Signature validation on inbound webhooks / status callbacks
                                      # NOTE (T3, Rule 1): Twilio's actual X-Twilio-Signature scheme signs
                                      # with the account's primary Auth Token itself (TWILIO_AUTH_TOKEN above),
                                      # not a separate secret — supabase/functions/_shared/twilio-signature.ts
                                      # verifies against TWILIO_AUTH_TOKEN. Leaving this var defined in case a
                                      # distinct Messaging-Service-level signing key is confirmed to exist.
# A2P 10DLC reseller-brand registration (SYSTEM_DESIGN §7, G4) — filled in once the brand/campaign are approved:
TWILIO_A2P_BRAND_SID=                # platform-level BrandRegistration SID (Week-0, one-time — see api-a2p-register/handler.ts)
TWILIO_A2P_CAMPAIGN_SID=
A2P_PRIVACY_POLICY_URL=              # T4 api-a2p-register — must resolve to a real, live policy page (Twilio requirement as of the 2026-06-30 campaign-registration change)
A2P_TERMS_URL=
A2P_INTERNAL_SECRET=                 # lets api-provision (or another internal caller) trigger api-a2p-register without a tenant-owner JWT

# ── Stripe (billing: Checkout + Billing Meters) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=       # verifies /webhooks/stripe raw-body signature
STRIPE_METER_EVENT_NAME=             # the Billing Meter event name for metered minutes usage (scripts/setup-stripe.ts creates the Meter under this name)
CHECKOUT_SUCCESS_URL=                # T4 api-checkout — Stripe Checkout Session success_url (provisioning-progress screen)
CHECKOUT_CANCEL_URL=                 # T4 api-checkout — Stripe Checkout Session cancel_url

# ── PayPal (referral payouts) ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                   # sandbox | live
PAYPAL_WEBHOOK_ID=                   # for verifying PayPal webhook signatures on payout status events

# ── ElevenLabs (TTS voice IDs — portable across voice providers) ─────────
ELEVENLABS_API_KEY=                  # only needed if we manage/preview voices directly, outside Retell's own ElevenLabs passthrough

# ── Outreach: lead fetch ───────────────────────────────────────────────────
APOLLO_API_KEY=
OUTSCRAPER_API_KEY=

# ── Outreach: campaign send + reply webhooks ──────────────────────────────
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SIGNING_SECRET=
INSTANTLY_API_KEY=                   # alternate/second outreach send provider (SYSTEM_DESIGN §3 lists Smartlead/Instantly)
INSTANTLY_WEBHOOK_SIGNING_SECRET=

# ── Partner portal ─────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                   # for sourcemap upload / release creation in CI
SENTRY_ORG=
SENTRY_PROJECT=

# ── Claude (outreach personalization + reply intent classification) ──────
ANTHROPIC_API_KEY=

# ── App-level ──────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
APP_BASE_URL=http://localhost:3000   # used to build absolute links in outbound SMS/email

# ── Email (Resend — BACKEND_SPEC §10.2 recommendation, MASTER_SPEC §2 binding) ──
RESEND_API_KEY=
RESEND_FROM_ADDRESS=                 # e.g. notifications@heyloo.app — must be a Resend-verified sending domain

# ── Geocoding (MASTER_SPEC §3.0 create_order delivery-radius check) ──────
GEOCODE_API_KEY=                     # provider TBD at build time (Geocodio vs Google) — see docs/VERIFY.md

# ── Edge functions: internal auth / cron (supabase/functions, T3) ─────────
CRON_INVOKE_SECRET=                  # shared secret pg_cron's pg_net calls present to worker-*/job-* functions
PROVISION_INTERNAL_SECRET=           # lets webhooks-stripe trigger api-provision without a tenant-owner JWT
ADMIN_AAL2_FRESHNESS_MINUTES=15      # BACKEND_SPEC §11.3 — session-level only, see admin-auth.ts's own caveat
VOICE_TOOLS_WEBHOOK_URL=             # T4 admin/index.ts — https://<project-ref>.supabase.co/functions/v1/voice-tools, passed to the template compiler as each tool's webhook `url`

# ── Edge functions: per-function webhook URLs (must match the exact URL the
# ── provider signs against — trailing slash/query mismatches break
# ── signature verification silently) ──────────────────────────────────────
WEBHOOKS_TWILIO_SMS_URL=             # https://<project-ref>.supabase.co/functions/v1/webhooks-twilio-sms
WEBHOOKS_POS_SQUARE_URL=             # https://<project-ref>.supabase.co/functions/v1/webhooks-pos/square

# ── Edge functions: outreach webhook auth (BACKEND_SPEC §7.5 — provider TBD) ─
OUTREACH_WEBHOOK_SECRET=             # shared-secret header until Smartlead/Instantly + a real HMAC scheme is picked

# ── Edge functions: Square POS adapter (webhooks-pos, first handleWebhook) ──
SQUARE_WEBHOOK_SIGNATURE_KEY=        # HMAC-SHA256(notificationUrl + rawBody) — re-verify against Square's current docs

# ── Edge functions: demo agent (api-demo-agent, BACKEND_SPEC §7.8) ────────
ANTHROPIC_DEMO_MODEL=claude-3-5-haiku-20241022  # hours/services extraction pass; keep cheap/fast, <60s demo budget
DEMO_AGENT_ID=                       # Retell agent id the demo web-call token is minted against
DEMO_PHONE_E164=                     # shared demo phone number shown alongside the web-call option

# ── Edge functions: phone payments (voice-tools send_payment_link, MASTER_SPEC §3.2) ─
PAYMENT_LINK_SUCCESS_URL=            # Stripe Checkout success redirect
PAYMENT_LINK_CANCEL_URL=             # Stripe Checkout cancel redirect

# ── Edge functions: Retell failover (job-retell-health-failover, G5) ──────
RETELL_FAILOVER_VOICE_URL=           # TwiML voice URL Twilio numbers are flipped to during a Retell outage (forward-to-owner-cell + voicemail)
