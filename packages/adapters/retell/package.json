{
  "name": "@heyloo/adapter-retell",
  "version": "0.0.0",
  "private": true,
  "description": "Retell (voice provider) adapter — the ONLY package allowed to import a Retell payload shape or call the Retell REST API directly (CLAUDE.md Rule 2, packages/adapters/README.md). Implements VoiceProvider from @heyloo/canonical-types.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run"
  },
  "dependencies": {
    "@heyloo/canonical-types": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "retell-sdk": "5.64.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
