# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.turbo/
.next/
out/

# Test / coverage
coverage/
.vitest-cache/

# Env files — never commit real values; .env.example documents every var.
.env
.env.*
!.env.example
*.env
server/.env
server/.env.*

# Supabase local dev
supabase/.temp/
supabase/.branches/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Playwright / test artifacts (not part of the build)
.playwright-mcp/
test-results/
playwright-report/
# Saved auth storageState from the "setup" project (T9,
# apps/web/tests/e2e/auth.setup.ts) — real (local-Supabase-only) session
# tokens, never committed even though they're only ever valid against a
# throwaway local `supabase start` instance.
playwright/.auth/

# per-agent git worktrees created by Claude Code (never commit a nested checkout)
.claude/worktrees/
